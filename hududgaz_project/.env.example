# Nusxa oling: .env nomi bilan saqlang va to'ldiring
BOT_TOKEN=123456:ABC-DEF...            # @BotFather bergan token
WEBAPP_URL=https://xxxx.trycloudflare.com   # Mini App HTTPS manzili (tunnel)
SECRET_KEY=o'zingizning-uzun-tasodifiy-kalitingiz
DEBUG=1                                # productionda 0
DEV_AUTH=1                             # 1 = brauzerda Telegramsiz sinash mumkin (productionda 0!)
DEMO_PAYMENTS=1                        # 1 = "Hisobni to'ldirish" demo rejimida ishlaydi
GAS_TARIFF=1800                        # 1 m3 narxi (so'm) - o'zingiz to'g'rilang
CHAT_PER_MINUTE=15                     # AI chatga daqiqasiga nechta xabar
# Payme merchant (kabinetdagi "Endpoint URL" = https://SIZNING-DOMEN/api/payme/)
PAYME_MERCHANT_ID=
PAYME_KEY=                             # test kalit yoki asosiy kalit
PAYME_TEST=1                           # 1 = test.paycom.uz, 0 = checkout.paycom.uz
PAYME_ACCOUNT_FIELD=account            # kabinetda belgilangan account maydon nomi
OPENAI_API_KEY=                        # bo'sh bo'lsa AI oddiy FAQ rejimida ishlaydi
OPENAI_MODEL=gpt-4o-mini
# PostgreSQL kerak bo'lsa (bo'sh bo'lsa SQLite ishlatiladi):
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
